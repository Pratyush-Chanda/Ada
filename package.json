    "postcss-value-parser": "^4.2.0",
    "serve": "^14.2.0"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.3",
    "bcrypt": "^6.0.0",
    "dotenv-cli": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.12.4"
  }
