{
  "name": "notebooks-science",
  "version": "1.0.0",
  "description": "NoteBooks XI - A structured knowledge system for students and educators",
  "scripts": {
    "dev": "node scripts/prepare-next-public.cjs && next dev",
    "build": "node scripts/prepare-next-public.cjs && next build",
    "start": "next start",
